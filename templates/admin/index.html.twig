{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}
    <h1 class="text-center">Tableau de bord</h1>
{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-12">
            <h3>Lieux historiques à valider : {{ placesNoActived|length }}</h3>
            <ul>
                {% for place in placesNoActived %}
                    <li class="my-2">
                        <a href="{{ ea_url()
                                    .setController('App\\Controller\\Admin\\PlaceCrudController')
                                    .setAction('edit')
                                    .setEntityId(place.id)}}">{{ place.name }}</a> - créé par {{ place.users }} <span class="small">le {{ place.createdAt|date('d/m/Y') }}</span>
                         - {% if "ROLE_ADMIN" not in user.getRoles() %}
                         <a type="submit" class="btn btn-primary" href="{{ path('app_api_contact_postBackOffice', {'placeId': place.id}) }}">Requète admin</a>
                            {% endif %}
                         
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}